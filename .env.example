# Copy to .env (never commit .env). The app also works with NO key (offline rule-based mode).
LLM_PROVIDER=gemini            # gemini | groq | none
GEMINI_API_KEY=
GROQ_API_KEY=
# Model names change over time - set a model that is currently available to your key:
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
